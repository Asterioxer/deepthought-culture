# =========================================================================
# Federer Company Discovery Engine - Configuration Template
# =========================================================================

# 1. LLM Provider Selector (Choose: gemini, groq, or ollama)
# Default: gemini
LLM_PROVIDER=gemini

# 2. Gemini Configuration (Primary)
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=enter_your_api_key

# 3. Groq Configuration (Secondary)
# Get an API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=enter_your_api_key

# 4. Ollama Configuration (Offline Fallback)
# Install Ollama locally from: https://ollama.com/
# Default base URL is http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Default model name. Recommended: qwen3:8b (or llama3.1:8b)
OLLAMA_MODEL=qwen2.5:7b

# 5. Scraper Settings (Optional)
# Limit concurrent browser scraping instances to prevent rate limiting and resource strain
MAX_CONCURRENT_SCRAPES=5
PLAYWRIGHT_TIMEOUT_MS=15000
